{
  "name": "playground-testing",
  "version": "1.0.0",
  "description": "Playground UI & API automation testing with Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "posttest": "npx ts-node scripts/generate-stakeholder-dashboard.ts",
    "test:ui": "playwright test --project=playground-ui",
    "posttest:ui": "npx ts-node scripts/generate-stakeholder-dashboard.ts",
    "test:playground-ui": "playwright test --project=playground-ui",
    "posttest:playground-ui": "npx ts-node scripts/generate-stakeholder-dashboard.ts",
    "test:backend": "playwright test --project=api-tests",
    "posttest:backend": "npx ts-node scripts/generate-stakeholder-dashboard.ts",
    "test:playground-backend": "playwright test --project=api-tests",
    "posttest:playground-backend": "npx ts-node scripts/generate-stakeholder-dashboard.ts",
    "test:health": "playwright test src/tests/backend/health.spec.ts --project=api-tests",
    "posttest:health": "npx ts-node scripts/generate-stakeholder-dashboard.ts",
    "test:all": "playwright test",
    "posttest:all": "npx ts-node scripts/generate-stakeholder-dashboard.ts",
    "test:playground-all": "playwright test",
    "posttest:playground-all": "npx ts-node scripts/generate-stakeholder-dashboard.ts",
    "test:headed": "playwright test --headed --project=playground-ui",
    "test:debug": "playwright test --debug",
    "playground:login": "npx ts-node scripts/save-playground-auth.ts",
    "playground:verify-auth": "npx ts-node scripts/verify-playground-auth.ts",
    "playground:refresh-auth": "npx ts-node scripts/refresh-playground-auth.ts",
    "test:playground-daily": "bash scripts/run-playground-daily.sh",
    "test:playground-daily:status": "bash scripts/playground-daily-status.sh",
    "test:playground-daily:stop": "bash scripts/playground-daily-stop.sh",
    "report:playground": "npx ts-node scripts/generate-playground-report.ts",
    "report:playground:open": "npx ts-node scripts/generate-playground-report.ts && open reports/Playground-Report.html",
    "email:playground": "npx ts-node scripts/send-playground-email.ts",
    "email:playground:daily": "bash scripts/send-playground-daily-email.sh",
    "email:playground:install": "bash scripts/install-playground-daily-email.sh",
    "schedule:playground:install": "bash scripts/install-playground-schedule.sh",
    "dashboard:generate": "npx ts-node scripts/generate-stakeholder-dashboard.ts",
    "dashboard:open": "npx ts-node scripts/generate-stakeholder-dashboard.ts && open reports/Stakeholder-Dashboard.html",
    "sheet:master": "npx ts-node scripts/write-master-test-sheet.ts",
    "sheet:populate-input": "npx ts-node scripts/populate-exhaustive-master-sheet.ts",
    "sheet:record-run": "npx ts-node scripts/record-test-run-to-sheet.ts"
  },
  "keywords": [
    "playground",
    "asr",
    "speech-recognition",
    "playwright",
    "api-testing",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^25.1.0",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/imap": "^0.8.43",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^7.0.11",
    "imap": "^0.8.19",
    "imapflow": "^1.3.3",
    "mailparser": "^3.9.9",
    "nodemailer": "^8.0.2"
  }
}
