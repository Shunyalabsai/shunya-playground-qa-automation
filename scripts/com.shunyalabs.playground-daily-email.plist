<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shunyalabs.playground-daily-email</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_PROJECT_DIR/scripts/send-playground-daily-email.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPLACE_PROJECT_DIR</string>

  <!-- Once per day at 8:00 PM local time -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>REPLACE_PROJECT_DIR/logs/launchd-daily-email.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_PROJECT_DIR/logs/launchd-daily-email-error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
